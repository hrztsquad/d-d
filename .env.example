# Telegram Bot Token dari @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Password opsional untuk membuka bot di Telegram (kosongkan jika tanpa password)
BOT_PASSWORD=12345

# Port untuk portal web minimalis
PORTAL_PORT=3000

# Admin Telegram ID (untuk command admin seperti /addquota)
ADMIN_ID=

# Direktori untuk file download sementara
DOWNLOAD_DIR=./downloads

# Force Subscribe Channel (opsional, kosongkan atau biarkan default jika tidak dipakai)
CHANNEL_USERNAME=@your_channel
CHANNEL_ID=-1001234567890

# ========== CASHI PAYMENT (QRIS) - Opsional ==========
# Kosongkan untuk mematikan fitur QRIS
CASHI_API_KEY=
CASHI_WEBHOOK_SECRET=
WEBHOOK_PORT=3001

# ========== EXTRACTOR MODE ==========
# - puppeteer : Menggunakan browser (lebih reliable)
# - ytdlp     : Menggunakan yt-dlp (butuh install yt-dlp)
EXTRACTOR_MODE=puppeteer
